# Copy this file to .env and fill in your own values.
# Both architecture-docker-compose.yml and application-docker-compose.yml read from .env automatically.

# --- Shared Postgres (used by SonarQube) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=initial_database

# --- SonarQube ---
SONAR_JDBC_URL=jdbc:postgresql://postgres:5432/sonarqube
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=change_me

# --- App's own Postgres (job_tracker_db) ---
JOB_TRACKER_DB_USER=postgres
JOB_TRACKER_DB_PASSWORD=change_me
JOB_TRACKER_DB_NAME=job_tracker

# --- Application ---
ENABLE_AI_EXTRACTION=true
GROQ_API_KEY=your_groq_api_key_here
